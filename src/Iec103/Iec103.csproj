<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Iec103</RootNamespace>

    <!-- 文档与诊断 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 包元数据 -->
    <Version>0.1.0</Version>
    <Authors>djw</Authors>
    <Copyright>Copyright © 2026 djw</Copyright>
    <Description>DL/T 667-1999 (IEC 60870-5-103) master &amp; slave protocol stack for .NET — FT1.2 link layer, ASDU codec, disturbance records with waveform retrieval, generic classification read/write, TCP &amp; serial transports.</Description>
    <PackageTags>iec103;iec-60870-5-103;dlt667;power-system;protection;relay;scada;substation;protocol;industrial;telecontrol</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vitusdong/iec103-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vitusdong/iec103-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release.</PackageReleaseNotes>

    <!-- 源码链接与嵌入式调试符号（nuget.org 上可单步进源码） -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
